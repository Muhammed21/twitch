{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "promise", "unicorn", "vitest"],
  "jsPlugins": ["./packages/lint/src/index.ts"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": "off",
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "prefer-const": "error",
    "no-var": "error",
    "no-floating-promises": "error",
    "no-misused-promises": "error",
    "promise/no-return-wrap": "error",
    "no-promise-executor-return": "error",
    "import/no-cycle": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "no-shadow": "error",
    "preserve-caught-error": "error",
    "unicorn/no-array-sort": "error",
    "unicorn/no-array-reverse": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@prisma/internals",
            "message": "API interne de Prisma : passer par packages/db/scripts/schema-lint/read-prisma-schema.ts (ADR 0025 §5)."
          }
        ]
      }
    ],
    "typescript/no-extraneous-class": [
      "error",
      {
        "allowWithDecorator": true
      }
    ],
    "twitch/module-boundaries": "error",
    "twitch/layer-dependencies": "error",
    "twitch/no-disable-architecture": "error"
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    "reports",
    ".turbo",
    ".stryker-tmp",
    "packages/design-tokens/platforms/**",
    "packages/db/src/generated/**"
  ],
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "no-shadow": "off"
      }
    },
    {
      "files": ["packages/db/scripts/schema-lint/read-prisma-schema.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["apps/api/src/modules/*/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@prisma/internals",
                "message": "API interne de Prisma : passer par packages/db/scripts/schema-lint/read-prisma-schema.ts (ADR 0025 §5)."
              }
            ],
            "patterns": [
              {
                "group": ["@nestjs/*", "nestjs-zod", "@prisma/*", "zod", "zod/*", "@repo/db"],
                "message": "Le domaine ne dépend ni de NestJS, ni de Prisma, ni de Zod, ni de @repo/db : ces dépendances vivent dans infrastructure et presentation (ADR 0002, ADR 0009). La couche application recevra la même règle avec son premier fichier."
              }
            ]
          }
        ]
      }
    }
  ]
}
