# Copier en .env pour le développement local (ADR 0028). Valeurs factices, locales uniquement.
# Les mots de passe PG_PASSWORD_* sont lus par db-init ; ils doivent correspondre aux DATABASE_URL_*.

# PostgreSQL : superutilisateur du conteneur, jamais utilisé par les applications
POSTGRES_PASSWORD=dev_postgres
POSTGRES_PORT=5432

# Mots de passe des rôles (ADR 0025, ADR 0028 §3)
PG_PASSWORD_MIGRATOR=dev_migrator
PG_PASSWORD_APP_IDENTITY=dev_app_identity
PG_PASSWORD_APP_CHANNEL=dev_app_channel
PG_PASSWORD_APP_STREAM=dev_app_stream
PG_PASSWORD_APP_CHAT=dev_app_chat
PG_PASSWORD_APP_MODERATION=dev_app_moderation
PG_PASSWORD_APP_DISCOVERY=dev_app_discovery
PG_PASSWORD_APP_MONETIZATION=dev_app_monetization
PG_PASSWORD_APP_NOTIFICATION=dev_app_notification
PG_PASSWORD_APP_OUTBOX_RELAY=dev_app_outbox_relay
PG_PASSWORD_APP_HEALTH=dev_app_health
PG_PASSWORD_PAYLOAD=dev_payload

# Connexions des applications, une par rôle (ADR 0028 §9)
DATABASE_URL_MIGRATOR=postgresql://migrator:dev_migrator@127.0.0.1:5432/app
DATABASE_URL_IDENTITY=postgresql://app_identity:dev_app_identity@127.0.0.1:5432/app
DATABASE_URL_CHANNEL=postgresql://app_channel:dev_app_channel@127.0.0.1:5432/app
DATABASE_URL_STREAM=postgresql://app_stream:dev_app_stream@127.0.0.1:5432/app
DATABASE_URL_CHAT=postgresql://app_chat:dev_app_chat@127.0.0.1:5432/app
DATABASE_URL_MODERATION=postgresql://app_moderation:dev_app_moderation@127.0.0.1:5432/app
DATABASE_URL_DISCOVERY=postgresql://app_discovery:dev_app_discovery@127.0.0.1:5432/app
DATABASE_URL_MONETIZATION=postgresql://app_monetization:dev_app_monetization@127.0.0.1:5432/app
DATABASE_URL_NOTIFICATION=postgresql://app_notification:dev_app_notification@127.0.0.1:5432/app
DATABASE_URL_OUTBOX_RELAY=postgresql://app_outbox_relay:dev_app_outbox_relay@127.0.0.1:5432/app
DATABASE_URL_HEALTH=postgresql://app_health:dev_app_health@127.0.0.1:5432/app
PAYLOAD_DATABASE_URL=postgresql://payload:dev_payload@127.0.0.1:5432/payload

# Redis
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Stockage objet compatible S3 (SeaweedFS en local, R2 en production)
S3_PORT=8333
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=twitch-local
S3_ACCESS_KEY_ID=dev_access_key
S3_SECRET_ACCESS_KEY=dev_secret_key

# Emails capturés par Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
