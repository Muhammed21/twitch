# Copier en .env pour le développement local (ADR 0028). Valeurs factices, locales uniquement.
# Les mots de passe PG_PASSWORD_* sont lus par db-init ; ils doivent correspondre aux DATABASE_URL_*.

# PostgreSQL : superutilisateur du conteneur, jamais utilisé par les applications
POSTGRES_PASSWORD=dev_postgres
POSTGRES_PORT=5432

# Mots de passe des rôles (ADR 0025, ADR 0028 §3)
PG_PASSWORD_MIGRATOR=dev_migrator
PG_PASSWORD_APP_IDENTITY=dev_app_identity
PG_PASSWORD_APP_CHANNEL=dev_app_channel
PG_PASSWORD_APP_STREAM=dev_app_stream
PG_PASSWORD_APP_CHAT=dev_app_chat
PG_PASSWORD_APP_MODERATION=dev_app_moderation
PG_PASSWORD_APP_DISCOVERY=dev_app_discovery
PG_PASSWORD_APP_MONETIZATION=dev_app_monetization
PG_PASSWORD_APP_NOTIFICATION=dev_app_notification
PG_PASSWORD_APP_VIDEO=dev_app_video
PG_PASSWORD_APP_OUTBOX_RELAY=dev_app_outbox_relay
PG_PASSWORD_APP_PROJECTION_REBUILD=dev_app_projection_rebuild
PG_PASSWORD_APP_HEALTH=dev_app_health
PG_PASSWORD_PAYLOAD=dev_payload

# Connexions des applications, une par rôle (ADR 0028 §9)
# secretlint-disable -- identifiants factices, locaux à 127.0.0.1
DATABASE_URL_MIGRATOR=postgresql://migrator:dev_migrator@127.0.0.1:5432/app
DATABASE_URL_IDENTITY=postgresql://app_identity:dev_app_identity@127.0.0.1:5432/app
DATABASE_URL_CHANNEL=postgresql://app_channel:dev_app_channel@127.0.0.1:5432/app
DATABASE_URL_STREAM=postgresql://app_stream:dev_app_stream@127.0.0.1:5432/app
DATABASE_URL_CHAT=postgresql://app_chat:dev_app_chat@127.0.0.1:5432/app
DATABASE_URL_MODERATION=postgresql://app_moderation:dev_app_moderation@127.0.0.1:5432/app
DATABASE_URL_DISCOVERY=postgresql://app_discovery:dev_app_discovery@127.0.0.1:5432/app
DATABASE_URL_MONETIZATION=postgresql://app_monetization:dev_app_monetization@127.0.0.1:5432/app
DATABASE_URL_NOTIFICATION=postgresql://app_notification:dev_app_notification@127.0.0.1:5432/app
DATABASE_URL_VIDEO=postgresql://app_video:dev_app_video@127.0.0.1:5432/app
DATABASE_URL_OUTBOX_RELAY=postgresql://app_outbox_relay:dev_app_outbox_relay@127.0.0.1:5432/app
DATABASE_URL_PROJECTION_REBUILD=postgresql://app_projection_rebuild:dev_app_projection_rebuild@127.0.0.1:5432/app
DATABASE_URL_HEALTH=postgresql://app_health:dev_app_health@127.0.0.1:5432/app
PAYLOAD_DATABASE_URL=postgresql://payload:dev_payload@127.0.0.1:5432/payload
# secretlint-enable

# API (apps/api)
API_PORT=3000
# Nombre de reverse proxys de confiance devant l'API (ADR 0042). 0 : l'IP du client est celle de la
# connexion et X-Forwarded-For est ignoré. N : l'IP est le N-ième saut de X-Forwarded-For en partant
# de la droite. Obligatoire, de 0 à 10.
API_TRUSTED_PROXY_COUNT=0

# better-auth (ADR 0005, ADR 0026). Secret factice, local uniquement : au moins 32 caractères.
# secretlint-disable
BETTER_AUTH_SECRET=dev-only-better-auth-secret-not-for-production
# secretlint-enable
BETTER_AUTH_URL=http://127.0.0.1:3000

# Chat (apps/chat, ADR 0004, ADR 0022) : jetons vérifiés contre le JWKS de l'API
CHAT_HTTP_PORT=3001
CHAT_API_BASE_URL=http://127.0.0.1:3000

# Service vidéo (apps/video, ADR 0031)
# Adapter vidéo de l'API : fake (provider factice) ou video (plan de contrôle d'apps/video, à VIDEO_SERVICE_URL).
VIDEO_PROVIDER=fake
VIDEO_SERVICE_URL=http://127.0.0.1:3002
# Base publique des playlists HLS d'apps/video, rendue à l'app par GET /v1/channels/{channelId}/playback.
VIDEO_PLAYBACK_BASE_URL=http://127.0.0.1:3002
VIDEO_HTTP_PORT=3002
VIDEO_RTMP_PORT=1935
VIDEO_INGEST_URL=rtmp://127.0.0.1:1935/live
# ffmpeg lancé par session de publication, et nombre maximal de sessions simultanées.
VIDEO_FFMPEG_PATH=ffmpeg
VIDEO_MAX_SESSIONS=4

# Secret du plan de contrôle, partagé avec l'API (ADR 0031, §2). Factice, local uniquement : au moins 32 caractères.
# secretlint-disable
VIDEO_SERVICE_SECRET=dev-only-video-service-secret-not-for-production
# secretlint-enable

# Clé AES-256-GCM qui chiffre les clés de stream en base (ADR 0031) : 32 octets en base64. Factice, local uniquement.
# secretlint-disable
VIDEO_STREAM_KEY_ENCRYPTION_KEY=ZGV2LW9ubHktdmlkZW8tc3RyZWFtLWtleS1jaXBoZXI=
# secretlint-enable

# Webhooks d'apps/video vers l'API (ADR 0031), signés par VIDEO_WEBHOOK_SECRET, que l'API vérifie.
# Secret factice, local uniquement : au moins 32 caractères.
VIDEO_WEBHOOK_URL=http://127.0.0.1:3000/v1/webhooks/video
# secretlint-disable
VIDEO_WEBHOOK_SECRET=dev-only-video-webhook-secret-not-for-production
# secretlint-enable

# App mobile (ADR 0009, ADR 0012) : version minimale supportée et évaluation des flags renvoyées par GET /v1/mobile/bootstrap.
# FEATURE_FLAGS_PROVIDER : defaults (valeurs par défaut sûres) ou posthog (POSTHOG_HOST et POSTHOG_PROJECT_API_KEY requis).
MOBILE_MIN_SUPPORTED_VERSION=0.1.0
FEATURE_FLAGS_PROVIDER=defaults

# Redis
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Relais de l'outbox (apps/api, process outbox-relay, ADR 0034 ; apps/video, dans son process)
OUTBOX_RELAY_INTERVAL_MS=1000

# Stockage objet compatible S3 (SeaweedFS en local, R2 en production)
S3_PORT=8333
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=twitch-local
S3_ACCESS_KEY_ID=dev_access_key
S3_SECRET_ACCESS_KEY=dev_secret_key

# Emails capturés par Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# Comptes et clients OAuth créés par pnpm seed:dev (apps/api/src/seed-dev/seed-dev.ts). Factices, locaux uniquement.
# secretlint-disable
# Viewer : viewer_dev (viewer@twitch.local) / twitch-dev-password, client twitch-ios-dev (twitch://oauth/callback)
# Administration : admin_dev (admin@twitch.local) / twitch-admin-password, rôle admin de la plateforme,
#   client twitch-admin-dev (http://127.0.0.1/callback, scope admin:category.manage)
# secretlint-enable
