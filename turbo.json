{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "tokens:check": {
      "cache": false
    },
    "check-contrast": {
      "inputs": ["tokens/**", "src/**", "scripts/**"]
    },
    "generate": {
      "inputs": ["tokens/**", "src/**", "scripts/**"],
      "outputs": ["platforms/**"]
    },
    "bench": {
      "cache": false,
      "outputs": ["bench-results.json"]
    }
  }
}
