{
  "printWidth": 100,
  "tabWidth": 2,
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "packages/design-tokens/platforms/**",
    "packages/db/src/generated/**",
    "packages/db/personal-fields.json",
    "packages/design-tokens/reports/**",
    "docs/CATALOG.md",
    "apps/api/openapi.json",
    "apps/ios/Packages/Core/Networking/Sources/openapi.json",
    "packages/docs-catalog/reports/**",
    "apps/payload/src/migrations/**",
    "apps/payload/src/app/(payload)/admin/importMap.js",
    "apps/payload/.next/**",
    "apps/payload/next-env.d.ts",
    "apps/payload/src/payload-types.ts"
  ],
  "sortImports": {
    "ignoreCase": true,
    "newlinesBetween": true,
    "internalPattern": ["@repo/"]
  }
}
