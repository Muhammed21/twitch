{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "inputs": [
        "prisma/schema/**",
        "prisma.config.ts",
        "src/schema-lint/**",
        "scripts/*.ts",
        "scripts/schema-lint/*.ts",
        "src/schema-version/**",
        "prisma/migrations/**"
      ],
      "outputs": ["src/generated/**", "personal-fields.json"]
    },
    "check-types": {
      "dependsOn": ["generate", "^check-types"]
    },
    "test": {
      "dependsOn": ["generate", "^build"]
    },
    "test:integration": {
      "dependsOn": ["generate"],
      "cache": false
    }
  }
}
