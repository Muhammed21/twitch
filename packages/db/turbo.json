{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "inputs": ["prisma/schema/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "check-types": {
      "dependsOn": ["generate", "^check-types"]
    },
    "test": {
      "dependsOn": ["generate", "^build"]
    },
    "test:integration": {
      "dependsOn": ["generate"],
      "cache": false
    }
  }
}
