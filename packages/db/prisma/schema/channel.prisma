// Contexte channel (ADR 0003) : la chaîne permanente d'un compte, créée à l'inscription.

/// Chaîne d'un compte : une par compte, slug unique (ADR 0035).
model Channel {
  id        String   @id @db.Uuid
  /// @personal
  ownerId   String   @unique @db.Uuid
  /// Dérivé du nom d'affichage.
  /// @personal
  slug      String   @unique
  title      String           @default("")
  /// Catégorie active posée par le propriétaire (ADR 0045), nulle tant qu'aucune n'est choisie.
  categoryId String?          @db.Uuid
  category   ChannelCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt  DateTime         @default(now())

  @@index([categoryId])
  @@schema("channel")
}

enum ChannelCategoryStatus {
  active
  merged
  retired

  @@schema("channel")
}

/// Catalogue des catégories (ADR 0021 §3, ADR 0045) : slug immuable, fusion vers une cible, retrait d'une catégorie inutilisée.
model ChannelCategory {
  id           String                @id @db.Uuid
  slug         String                @unique
  name         String
  status       ChannelCategoryStatus @default(active)
  /// Cible de la fusion quand status vaut merged.
  mergedIntoId String?               @db.Uuid
  createdAt    DateTime              @default(now())
  channels     Channel[]

  @@schema("channel")
}

model ChannelOutbox {
  id            String    @id @db.Uuid
  name          String
  version       Int
  payload       Json
  occurredAt    DateTime
  publishedAt   DateTime?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?

  @@index([publishedAt, nextAttemptAt])
  @@index([occurredAt, id])
  @@schema("channel")
}

model ChannelProcessedEvent {
  eventId     String   @db.Uuid
  handlerName String
  processedAt DateTime @default(now())

  @@unique([eventId, handlerName])
  @@schema("channel")
}
