// Contexte discovery (ADR 0003, §6) : des projections en lecture seule, reconstructibles depuis les outbox.

/// Vue d'une chaîne pour les listes de lives, alimentée par channel.* et stream.*. En live si liveSessionId est renseigné.
model DiscoveryLiveChannelView {
  channelId      String    @id @db.Uuid
  /// Copie du slug de la chaîne, nul tant que channel.created n'est pas arrivé.
  /// @personal
  slug           String?
  /// Propriétaire de la chaîne, copié de channel.created : l'avatar du live est le sien.
  /// @personal
  ownerId        String?   @db.Uuid
  title          String    @default("")
  /// occurredAt du dernier channel.metadata.updated appliqué : un titre plus ancien est ignoré.
  titleChangedAt DateTime?
  /// Catégorie posée par le dernier channel.metadata.updated, telle qu'il la nomme : une fusion se résout à la lecture.
  categoryId     String?   @db.Uuid
  liveSessionId  String?   @db.Uuid
  liveStartedAt  DateTime?
  lastEndedAt    DateTime?

  @@index([liveStartedAt(sort: Desc), channelId])
  @@schema("discovery")
}

enum DiscoveryCategoryStatus {
  active
  merged
  retired

  @@schema("discovery")
}

/// Vue d'une catégorie, alimentée par channel.category.*. Une catégorie fusionnée garde sa cible dans mergedIntoId.
model DiscoveryCategoryView {
  categoryId   String                  @id @db.Uuid
  /// Nul tant que channel.category.created n'est pas arrivé.
  slug         String?
  name         String                  @default("")
  status       DiscoveryCategoryStatus @default(active)
  mergedIntoId String?                 @db.Uuid
  /// Clé de la pochette, portée par channel.category.updated (ADR 0045 §6). L'URL est calculée à la lecture.
  imageKey     String?
  /// Tags de la catégorie, portés par channel.category.updated (ADR 0050).
  tags         String[]                @default([])

  @@schema("discovery")
}

/// Audience d'une catégorie qui a au moins un live, recalculée toutes les 15 s par un job (ADR 0047). Reconstructible.
model DiscoveryCategoryAudience {
  /// Catégorie active, fusions suivies.
  categoryId  String   @id @db.Uuid
  liveCount   Int
  viewerCount Int
  refreshedAt DateTime

  @@index([viewerCount(sort: Desc), liveCount(sort: Desc), categoryId])
  @@schema("discovery")
}

/// Dernière version connue de chaque paire suivie (ADR 0049 §6), projetée depuis channel.category.followed et unfollowed. Reconstructible.
model DiscoveryCategoryFollow {
  /// Identifiant nu d'un compte.
  /// @personal
  userId     String  @db.Uuid
  categoryId String  @db.Uuid
  following  Boolean
  version    Int

  @@id([userId, categoryId])
  @@schema("discovery")
}

/// Nombre de paires suivies par catégorie, changé dans la transaction de la paire (ADR 0049 §6). Reconstructible.
model DiscoveryCategoryFollowerCount {
  categoryId    String @id @db.Uuid
  followerCount Int

  @@schema("discovery")
}

model DiscoveryProcessedEvent {
  eventId     String   @db.Uuid
  handlerName String
  processedAt DateTime @default(now())

  @@unique([eventId, handlerName])
  @@schema("discovery")
}

/// Copie de l'avatar de chaque compte, alimentée par identity.avatar.changed (ADR 0003, ADR 0044).
model DiscoveryAccountAvatar {
  /// @personal
  accountId String   @id @db.Uuid
  /// Clé d'objet de l'avatar ; l'URL publique se calcule à la lecture.
  /// @personal
  avatarKey String
  /// occurredAt du dernier identity.avatar.changed appliqué : un avatar plus ancien est ignoré.
  changedAt DateTime

  @@schema("discovery")
}
