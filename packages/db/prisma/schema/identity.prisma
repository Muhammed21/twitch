// Tables de better-auth et de ses plugins jwt et oauth-provider (ADR 0005, ADR 0026), renommées par modelName.

model IdentityUser {
  id            String                      @id
  /// @personal
  name          String
  /// @personal
  email         String                      @unique
  /// @not-personal
  emailVerified Boolean                     @default(false)
  /// @personal
  image         String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  sessions      IdentitySession[]
  accounts      IdentityAccount[]
  oauthClients  IdentityOAuthClient[]
  refreshTokens IdentityOAuthRefreshToken[]
  accessTokens  IdentityOAuthAccessToken[]
  consents      IdentityOAuthConsent[]

  @@schema("identity")
}

model IdentitySession {
  id            String                      @id
  expiresAt     DateTime
  token         String                      @unique
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  /// @personal
  ipAddress     String?
  /// @personal
  userAgent     String?
  /// @personal
  userId        String
  user          IdentityUser                @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens IdentityOAuthRefreshToken[]
  accessTokens  IdentityOAuthAccessToken[]

  @@index([userId])
  @@schema("identity")
}

model IdentityAccount {
  id                    String       @id
  /// Identifiant du compte chez le fournisseur ; l'identifiant de l'utilisateur pour le fournisseur credential.
  /// @personal
  accountId             String
  providerId            String
  /// @personal
  userId                String
  user                  IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// @personal
  accessToken           String?
  /// @personal
  refreshToken          String?
  /// @personal
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Empreinte du mot de passe.
  /// @personal
  password              String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([userId])
  @@schema("identity")
}

model IdentityVerification {
  id         String   @id
  /// Destinataire de la vérification, en général un e-mail.
  /// @personal
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@schema("identity")
}

/// Clés de signature des jetons (EdDSA), clé privée chiffrée par le secret de better-auth (ADR 0026 §5).
model IdentityJwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@schema("identity")
}

model IdentityOAuthClient {
  id                               String                        @id
  clientId                         String                        @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?                      @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           Json?
  clientCredentialsScopes          Json?
  /// Propriétaire du client, pour un client enregistré par un utilisateur.
  /// @personal
  userId                           String?
  user                             IdentityUser?                 @relation(fields: [userId], references: [id])
  createdAt                        DateTime?                     @default(now())
  updatedAt                        DateTime?                     @updatedAt
  name                             String?
  uri                              String?
  icon                             String?
  /// Contacts du client, en général des e-mails.
  /// @personal
  contacts                         Json?
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           Json?
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       Json?
  responseTypes                    Json?
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?
  referenceId                      String?
  metadata                         Json?
  resources                        IdentityOAuthClientResource[]
  refreshTokens                    IdentityOAuthRefreshToken[]
  accessTokens                     IdentityOAuthAccessToken[]
  consents                         IdentityOAuthConsent[]

  @@schema("identity")
}

model IdentityOAuthResource {
  id                            String                        @id
  identifier                    String                        @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 Json?
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?
  disabled                      Boolean?
  createdAt                     DateTime?                     @default(now())
  updatedAt                     DateTime?                     @updatedAt
  policyVersion                 Int?
  metadata                      Json?
  clients                       IdentityOAuthClientResource[]

  @@schema("identity")
}

model IdentityOAuthClientResource {
  id         String                @id
  clientId   String
  client     IdentityOAuthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   IdentityOAuthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime?             @default(now())

  @@index([clientId])
  @@index([resourceId])
  @@schema("identity")
}

/// Jetons de rafraîchissement, stockés sous forme d'empreinte (ADR 0026 §2).
model IdentityOAuthRefreshToken {
  id                      String                     @id
  token                   String                     @unique
  clientId                String
  client                  IdentityOAuthClient        @relation(fields: [clientId], references: [clientId])
  sessionId               String?
  session                 IdentitySession?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  /// @personal
  userId                  String
  user                    IdentityUser               @relation(fields: [userId], references: [id])
  referenceId             String?
  authorizationCodeId     String?
  resources               Json?
  requestedUserInfoClaims Json?
  expiresAt               DateTime?
  createdAt               DateTime?                  @default(now())
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]
  accessTokens            IdentityOAuthAccessToken[]

  @@index([userId])
  @@index([clientId])
  @@schema("identity")
}

model IdentityOAuthAccessToken {
  id                      String                     @id
  token                   String?                    @unique
  clientId                String
  client                  IdentityOAuthClient        @relation(fields: [clientId], references: [clientId])
  sessionId               String?
  session                 IdentitySession?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  /// @personal
  userId                  String?
  user                    IdentityUser?              @relation(fields: [userId], references: [id])
  referenceId             String?
  authorizationCodeId     String?
  resources               Json?
  requestedUserInfoClaims Json?
  refreshId               String?
  refresh                 IdentityOAuthRefreshToken? @relation(fields: [refreshId], references: [id])
  expiresAt               DateTime?
  createdAt               DateTime?                  @default(now())
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@index([userId])
  @@index([clientId])
  @@schema("identity")
}

model IdentityOAuthConsent {
  id                      String              @id
  clientId                String
  client                  IdentityOAuthClient @relation(fields: [clientId], references: [clientId])
  /// @personal
  userId                  String?
  user                    IdentityUser?       @relation(fields: [userId], references: [id])
  referenceId             String?
  resources               Json?
  requestedUserInfoClaims Json?
  scopes                  String[]
  createdAt               DateTime?           @default(now())
  updatedAt               DateTime?           @updatedAt

  @@index([userId])
  @@schema("identity")
}

model IdentityOAuthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@schema("identity")
}
