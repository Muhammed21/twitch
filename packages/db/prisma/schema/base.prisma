generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
  schemas  = ["identity", "channel", "stream", "chat", "moderation", "discovery", "monetization", "notification", "video", "authz", "audit"]
}
