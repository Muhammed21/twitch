model ChatMessage {
  id       String @id
  /// Auteur du message
  /// @personal
  authorId String

  @@schema("chat")
}

model ChatProcessedEvent {
  id          String   @id
  eventId     String
  handlerName String
  processedAt DateTime @default(now())

  @@unique([handlerName, eventId])
  @@schema("chat")
}
