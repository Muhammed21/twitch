model VideoStream {
  id       String         @id
  state    VideoState
  sessions VideoSession[]
  /// @personal
  viewerId String
  /// @not-personal
  ownerId  String

  @@schema("video")
}

model VideoSession {
  id       String      @id
  stream   VideoStream @relation(fields: [streamId], references: [id])
  streamId String

  @@schema("video")
}

enum VideoState {
  LIVE
  ENDED

  @@schema("video")
}

// enum VideoState { LIVE @@schema("chat") }

model VideoOutbox {
  id            String    @id @db.Uuid
  name          String
  version       Int
  payload       Json
  occurredAt    DateTime
  publishedAt   DateTime?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?

  @@index([publishedAt, nextAttemptAt])
  @@schema("video")
}

model VideoProcessedEvent {
  eventId     String   @db.Uuid
  handlerName String
  processedAt DateTime @default(now())

  @@id([eventId, handlerName])
  @@schema("video")
}
