  "info": {
    "title": "Twitch API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "Uuid": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "Me": {
        "not": {
          "type": "string"
        }
      },
      "Channel": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "ownerId": {
            "$ref": "#/components/schemas/Uuid"
          }
        },
        "required": ["id", "slug", "title", "ownerId"],
        "additionalProperties": {}
      },
      "UpdateChannelRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          }
        },
        "required": ["title"],
        "additionalProperties": false
      },
      "StreamKey": {
        "type": "object",
        "properties": {
          "streamKey": {
            "type": "string",
            "minLength": 1
          },
          "ingestUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["streamKey", "ingestUrl"],
        "additionalProperties": {}
      },
      "TimeoutUserRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "durationSeconds": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": ["userId", "durationSeconds"],
        "additionalProperties": false
      },
      "Timeout": {
        "type": "object",
        "properties": {
          "channelId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "userId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": ["channelId", "userId", "expiresAt"],
        "additionalProperties": {}
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": ["path", "message"],
              "additionalProperties": {}
            }
          }
        },
        "required": ["type", "title", "status"],
        "additionalProperties": {}
      }
    }
  }
}
