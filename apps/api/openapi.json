  "info": {
    "title": "Twitch API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "Uuid": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ],
        "additionalProperties": {}
      },
      "Channel": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "ownerId": {
            "$ref": "#/components/schemas/Uuid"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "ownerId"
        ],
        "additionalProperties": {}
      },
      "UpdateChannelRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "StreamKey": {
        "type": "object",
        "properties": {
          "streamKey": {
            "type": "string",
            "minLength": 1
          },
          "ingestUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "streamKey",
          "ingestUrl"
        ],
        "additionalProperties": {}
      },
      "PresenceRequest": {
        "type": "object",
        "properties": {
          "viewerId": {
            "$ref": "#/components/schemas/Uuid"
          }
        }
      },
      "Playback": {
        "type": "object",
        "properties": {
          "playbackUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "playbackUrl"
        ],
        "additionalProperties": {}
      },
      "TimeoutUserRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "durationSeconds": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "userId",
          "durationSeconds"
        ],
        "additionalProperties": false
      },
      "Timeout": {
        "type": "object",
        "properties": {
          "channelId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "userId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "channelId",
          "userId",
          "expiresAt"
        ],
        "additionalProperties": {}
      },
      "Live": {
        "type": "object",
        "properties": {
          "channelId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "viewerCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "channelId",
          "slug",
          "title",
          "startedAt"
        ],
        "additionalProperties": {}
      },
      "LivePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Live"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": {}
      },
      "LiveStatus": {
        "type": "object",
        "properties": {
          "channelId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "live": {
            "type": "boolean"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "viewerCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "channelId",
          "live"
        ]
      },
      "Profile": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "channel": {
            "$ref": "#/components/schemas/OwnedChannel"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ],
        "additionalProperties": {}
      },
      "OwnedChannel": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug"
        ],
        "additionalProperties": {}
      },
      "MobileBootstrap": {
        "type": "object",
        "properties": {
          "minSupportedVersion": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "flags": {
            "type": "object",
            "properties": {
              "session_replay": {
                "type": "boolean"
              }
            },
            "required": [
              "session_replay"
            ],
            "additionalProperties": {}
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          }
        },
        "required": [
          "minSupportedVersion",
          "flags"
        ],
        "additionalProperties": {}
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ],
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "additionalProperties": {}
      },
      "RealtimeChatSend": {
        "type": "object",
        "properties": {
          "channelId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "channelId",
          "body"
        ],
        "additionalProperties": false
      },
      "RealtimeRoomJoin": {
        "type": "object",
        "properties": {
          "channelId": {
            "$ref": "#/components/schemas/Uuid"
          }
        },
        "required": [
          "channelId"
        ],
        "additionalProperties": false
      },
      "RealtimeRoomLeave": {
        "type": "object",
        "properties": {
          "channelId": {
            "$ref": "#/components/schemas/Uuid"
          }
        },
        "required": [
          "channelId"
        ],
        "additionalProperties": false
      },
      "RealtimeServerMessage": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "event": {
                "type": "string",
                "const": "chat:message"
              },
              "data": {
                "$ref": "#/components/schemas/RealtimeChatMessage"
              }
            },
            "required": [
              "event",
              "data"
            ],
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "event": {
                "type": "string",
                "const": "chat:rejected"
              },
              "data": {
                "$ref": "#/components/schemas/RealtimeChatRejected"
              }
            },
            "required": [
              "event",
              "data"
            ],
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "event": {
                "type": "string",
                "const": "session:revoked"
              },
              "data": {
                "$ref": "#/components/schemas/RealtimeSessionRevoked"
              }
            },
            "required": [
              "event",
              "data"
            ],
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "event": {
                "type": "string"
              }
            },
            "required": [
              "event"
            ],
            "additionalProperties": {}
          }
        ]
      },
      "RealtimeChatMessage": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "channelId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "sessionId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "author": {
            "$ref": "#/components/schemas/RealtimeChatAuthor"
          },
          "body": {
            "type": "string"
          },
          "sentAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "channelId",
          "author",
          "body",
          "sentAt"
        ],
        "additionalProperties": {}
      },
      "RealtimeChatAuthor": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "displayName"
        ],
        "additionalProperties": {}
      },
      "RealtimeChatRejected": {
        "type": "object",
        "properties": {
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "timed_out",
                  "banned",
                  "rate_limited",
                  "not_joined"
                ]
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "reason"
        ],
        "additionalProperties": {}
      },
      "RealtimeSessionRevoked": {
        "type": "object",
        "properties": {
          "action": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "refresh_and_reconnect",
                  "stop"
                ]
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": {}
      }
    }
  }
}
