{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^generate"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^generate", "^check-types"]
    },
    "test": {
      "dependsOn": ["^generate"]
    },
    "test:integration": {
      "dependsOn": ["^generate"],
      "cache": false,
      "passThroughEnv": [
        "INTEGRATION_*",
        "DATABASE_URL_*",
        "DATABASE_POOL_MAX_*",
        "PAYLOAD_DATABASE_URL",
        "REDIS_URL",
        "S3_*"
      ]
    },
    "generate": {
      "dependsOn": ["^generate"],
      "inputs": ["src/**", "tsconfig*.json", "package.json"],
      "outputs": ["openapi.json"]
    }
  }
}
